#!/usr/sbin/nft -f
# inventory/fw-policy.yml 에서 생성. 손으로 고치지 말 것
flush ruleset

table inet fw {
  # lb_vip = 10.10.32.0/24
  # k8s_node = 10.10.16.0/24
  # ceph_pub = 10.10.20.0/24
  # mgmt_hosts = 10.10.10.0/24
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    ct state invalid drop
    iifname "eth3" oifname "fw0.901" ip daddr 10.10.32.0/24 tcp dport { 80, 443 } accept  # r10 서비스 공개는 VIP의 80/443만
    iifname "fw0.901" oifname "eth3" tcp dport { 80, 443 } accept  # r20 레지스트리, 패키지 저장소
    iifname "fw0.901" oifname "eth3" udp dport { 53, 123 } accept  # r21 DNS, NTP
    iifname "eth4" oifname "fw0.901" tcp dport { 22, 6443, 9100, 9115, 10250 } accept  # r30 SSH, kube-apiserver, node_exporter, 경로 프로브, kubelet
    iifname "eth4" oifname "fw0.902" tcp dport { 22, 9100, 9283 } accept  # r31 SSH, node_exporter, ceph-mgr exporter
    iifname "eth4" oifname "fw0.901" meta l4proto icmp accept  # r32 진단용 ping
    iifname "eth4" oifname "fw0.902" meta l4proto icmp accept  # r32 진단용 ping
    iifname "fw0.901" oifname "fw0.902" log prefix "fw-r90 " drop
    iifname "fw0.902" oifname "eth3" log prefix "fw-r91 " drop
    iifname "eth3" oifname "fw0.902" log prefix "fw-r92 " drop
    iifname "eth3" oifname "eth4" log prefix "fw-r92 " drop
    log prefix "fw-default " drop
  }
}

table ip nat {
  chain prerouting {
    type nat hook prerouting priority -100;
    iifname "eth3" ip daddr 203.0.113.10 tcp dport { 80, 443 } dnat to 10.10.32.10
  }
  chain postrouting {
    type nat hook postrouting priority 100;
    iifname "fw0.901" oifname "eth3" masquerade
  }
}
