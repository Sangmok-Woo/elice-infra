! {{ name }} — inventory/site.yml 에서 생성. 손으로 고치지 말 것
frr version 10.2
frr defaults datacenter
hostname {{ name }}
log stdout informational
service integrated-vtysh-config
!
interface lo
 ip address {{ rid }}/32
!
{% for d in downlinks %}
interface {{ d }}
 description fabric-downlink
 ipv6 nd ra-interval 5
 no ipv6 nd suppress-ra
!
{% endfor %}
router bgp {{ asn }}
 bgp router-id {{ rid }}
 bgp log-neighbor-changes
 no bgp ebgp-requires-policy
 bgp bestpath as-path multipath-relax
 neighbor FABRIC peer-group
 neighbor FABRIC remote-as external
 neighbor FABRIC bfd
 neighbor FABRIC timers 3 9
{% for d in downlinks %}
 neighbor {{ d }} interface peer-group FABRIC
{% endfor %}
 !
 address-family ipv4 unicast
  network {{ rid }}/32
  maximum-paths 64
 exit-address-family
 !
 ! 스파인은 EVPN 경로를 중계만 한다. next-hop을 바꾸면 VXLAN 터널 목적지가 스파인이 되어 깨진다
 address-family l2vpn evpn
  neighbor FABRIC activate
  neighbor FABRIC attribute-unchanged next-hop
 exit-address-family
exit
!
line vty
!
